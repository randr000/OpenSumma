# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# Local databases (datasets are generated deterministically, never committed)
*.db
*.sqlite
*.sqlite3

# Generated datasets (erp dataset generate writes them to datasets/ by default).
# Anchored to the root: src/opensumma/datasets/ is the generator's own package,
# and the wheel build leaves out whatever this file ignores.
/datasets/

# Benchmark results (erp benchmark run writes them to results/ by default)
/results/
